version 24.2R1-S2.5;
groups {
    iface-switchport-trunk {
        interfaces {
            <*> {
                description "Backbone: trunk";
                unit 0 {
                    family ethernet-switching {
                        interface-mode trunk;
                        vlan {
                            members [ air life usr cast mgmt ];
                        }
                    }
                }
            }
        }
    }
    iface-switchport-usr {
        interfaces {
            <*> {
                description "Access: usr";
                unit 0 {
                    family ethernet-switching {
                        interface-mode access;
                        vlan {
                            members usr;
                        }
                    }
                }
            }
        }
    }
    iface-switchport-cast {
        interfaces {
            <*> {
                description "Access: cast";
                unit 0 {
                    family ethernet-switching {
                        interface-mode access;
                        vlan {
                            members cast;
                        }
                    }
                }
            }
        }
    }
    iface-switchport-life {
        interfaces {
            <*> {
                description "Access: life";
                unit 0 {
                    family ethernet-switching {
                        interface-mode access;
                        vlan {
                            members life;
                        }
                    }
                }
            }
        }
    }
    iface-switchport-air {
        interfaces {
            <*> {
                description "Access: air";
                native-vlan-id 200;
                unit 0 {
                    family ethernet-switching {
                        interface-mode trunk;
                        vlan {
                            members [ life usr air ];
                        }
                    }
                }
            }
        }
    }
    iface-switchport-platmgmt {
        interfaces {
            <*> {
                description "Upstream: platmgmt";
                native-vlan-id 1000;
                unit 0 {
                    family ethernet-switching {
                        interface-mode trunk;
                        vlan {
                            members [ usr mgmt ];
                        }
                    }
                }
            }
        }
    }
    iface-lacp {
        interfaces {
            <*> {
                aggregated-ether-options {
                    lacp {
                        active;
                        periodic fast;
                    }
                }
            }
        }
    }
    policy-skip-when-local-pref-is-zero {
        policy-options {
            policy-statement <*> {
                term skip-when-local-pref-is-zero {
                    from local-preference 0;
                    then next policy;
                }
            }
        }
    }
    optics-no-autoneg {
        interfaces {
            <ae*> {
                aggregated-ether-options {
                    link-speed 1g;
                }
            }
            <ge-*> {
                speed 1g;
                ether-options {
                    no-auto-negotiation;
                }
            }
        }
    }
    iface-switchport-mgmt {
        interfaces {
            <*> {
                description "Access: mgmt";
                unit 0 {
                    family ethernet-switching {
                        interface-mode access;
                        vlan {
                            members mgmt;
                        }
                    }
                }
            }
        }
    }
    ipv6ra-common {
        protocols {
            router-advertisement {
                interface <*> {
                    dns-server-address 2001:df0:8500:ca6d:53::c {
                        lifetime 1800;
                    }
                    dns-server-address 2001:df0:8500:ca6d:53::d {
                        lifetime 1800;
                    }
                    dns-search-list venue.rubykaigi.net {
                        lifetime 3600;
                    }
                }
            }
        }
    }
    ipv6ra-pref64n {
        protocols {
            router-advertisement {
                interface <*> {
                    nat-prefix 2001:df0:8500:ca64:a9:8200::/96 {
                        lifetime 1800;
                    }
                }
            }
        }
    }
}
