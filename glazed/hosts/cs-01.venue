    services {
        netconf {
            ssh;
        }
        ssh {
            root-login deny;
            protocol-version v2;
            ciphers [ "aes256-gcm@openssh.com" "aes128-gcm@openssh.com" aes256-ctr aes192-ctr aes128-ctr ];
            macs [ hmac-sha2-256 hmac-sha2-512 ];
            key-exchange [ ecdh-sha2-nistp521 ecdh-sha2-nistp384 ecdh-sha2-nistp256 curve25519-sha256 group-exchange-sha2 ];
            hostkey-algorithm-list {
                ecdsa-sha2-nistp521;
                ed25519;
            }
        }
    }
    domain-name f.rubykaigi.net;
    time-zone UTC;
    default-address-selection;
    no-redirects;
    internet-options {
        tcp-drop-synfin-set;
        no-tcp-reset drop-all-tcp;
    }
    name-server {
        192.50.220.164;
        192.50.220.165;
    }
    syslog {
        archive {
            size 100k;
            files 3;
        }
        user * {
            any emergency;
        }
        host syslog.rubykaigi.net {
            any info;
            allow-duplicates;
        }
        file interactive-commands {
            interactive-commands any;
        }
        file messages {
            any notice;
            authorization info;
        }
    }
    max-configurations-on-flash 10;
    ##
    ## Warning: statement ignored: unsupported platform (ex3400-24p)
    ##
    max-configuration-rollbacks 5;
    ntp {
        server 2001:4860:4806::;
        server 2001:4860:4806:4::;
        server 2001:4860:4806:8::;
        server 2001:4860:4806:c::;
    }
}
chassis {
    redundancy {
        graceful-switchover;
    }
    aggregated-devices {
        ethernet {
            device-count 12;
        }
    }
}
