snmp {
    filter-interfaces {
        interfaces {
            "\.0$";
        }
        all-internal-interfaces;
    }
    stats-cache-lifetime 59;
    community [~REDACTED:dgst=peVe40DhSUw~] {
        authorization read-only;
    }
}
forwarding-options {
    storm-control-profiles default {
        all;
    }
    analyzer {
        inactive: sorah-tmp-0319 {
            input {
                ingress {
                    interface ge-0/0/0.0;
                }
                egress {
                    interface ge-0/0/0.0;
                }
            }
            output {
                vlan {
                    sorah-tmp-0319;
                }
            }
        }
    }
    enhanced-hash-key {
        inet {
            no-incoming-port;
            no-incoming-device;
            no-l4-source-port;
            no-l4-destination-port;
            no-protocol;
            no-ipv4-destination-address;
        }
        inet6 {
            no-incoming-port;
            no-incoming-device;
            no-l4-source-port;
            no-l4-destination-port;
            no-next-header;
            no-ipv6-destination-address;
        }
    }
    dhcp-relay {
        overrides {
            trust-option-82;
        }
        relay-option-82 {
            circuit-id {
                prefix {
                    host-name;
                }
            }
        }
        forward-only;
        server-group {
            kea4 {
                10.33.136.67;
                10.33.152.67;
            }
        }
        group kea4 {
            active-server-group kea4;
            interface irb.200;
            interface irb.300;
            interface irb.400;
            interface irb.410;
            interface irb.1000;
        }
    }
}
policy-options {
    prefix-list bogon4 {
        10.0.0.0/8;
        100.64.0.0/10;
        127.0.0.0/8;
        169.254.0.0/16;
        172.16.0.0/12;
        192.0.2.0/24;
        192.168.0.0/16;
        198.18.0.0/15;
        198.51.100.0/24;
        203.0.113.0/24;
        224.0.0.0/3;
    }
    prefix-list bogon6 {
        ::/96;
        ::1/128;
        ::ffff:0:0/96;
        100::/64;
        2001:2::/48;
        2001:db8::/32;
        fc00::/7;
        fec0::/10;
        ff00::/8;
    }
    prefix-list link4 {
        10.33.22.0/24;
        192.50.220.152/29;
    }
    prefix-list link6 {
        2001:df0:8500:ca20::/60;
        fe80::/64;
    }
    prefix-list mgmt4 {
        10.33.0.0/24;
        10.33.1.0/24;
        10.33.128.0/17;
        192.50.220.152/32;
        192.50.220.154/32;
        192.50.220.156/32;
    }
    prefix-list mgmt6 {
        2001:0df0:8500:ca00::/64;
        2001:0df0:8500:caa0::/64;
        2001:0df0:8500:cab0::/64;
        2406:da14:dfe:c000::/56;
    }
    prefix-list onpremises4 {
        10.33.0.0/17;
    }
    prefix-list pa6 {
        2001:df0:8500:ca00::/56;
    }
    prefix-list pref64n {
        2001:0df0:8500:ca60::/60;
    }
    prefix-list private4 {
        10.33.0.0/16;
        10.33.0.0/17;
        10.33.128.0/18;
    }
    prefix-list private6 {
        2001:df0:8500:ca00::/56;
        2406:da14:dfe:c000::/56;
    }
    prefix-list public4 {
        192.50.220.152/29;
        192.50.220.160/29;
        192.50.220.168/29;
    }
    prefix-list public6 {
        2406:da14:dfe:c02f:ffff::/127;
    }
    policy-statement accept {
        then accept;
    }
    policy-statement aws-local-pref-hi {
        then {
            community add AWS:LOCAL_PREF_HIGH;
        }
    }
    policy-statement aws-local-pref-low {
        then {
            community add AWS:LOCAL_PREF_LOW;
        }
    }
    policy-statement aws-local-pref-med {
        then {
            community add AWS:LOCAL_PREF_MEDIUM;
        }
    }
    policy-statement bb-filter {
        term default4 {
            from {
                route-filter 0.0.0.0/0 exact;
            }
            then next policy;
        }
        term default6 {
            from {
                route-filter ::/0 exact;
            }
            then next policy;
        }
        term private4 {
            from {
                family inet;
                prefix-list-filter private4 orlonger;
            }
            then next policy;
        }
        term private6 {
            from {
                family inet6;
                prefix-list-filter private6 orlonger;
            }
            then next policy;
        }
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term public6 {
            from {
                family inet6;
                prefix-list-filter public6 orlonger;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement default-filter {
        term default4 {
            from {
                family inet;
                route-filter 0.0.0.0/0 exact;
            }
            then next policy;
        }
        term default6 {
            from {
                family inet6;
                route-filter ::/0 exact;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement default4-reject {
        term default4 {
            from {
                family inet;
                route-filter 0.0.0.0/0 exact;
            }
            then reject;
        }
    }
    policy-statement default6-reject {
        term default6 {
            from {
                family inet6;
                route-filter ::/0 exact;
            }
            then reject;
        }
    }
    policy-statement ecmp {
        then {
            load-balance per-packet;
        }
    }
    policy-statement export-multipath {
        term multipath {
            then {
                load-balance per-flow;
            }
        }
    }
    policy-statement local-pref-lo {
        apply-groups policy-skip-when-local-pref-is-zero;
        then {
            local-preference 90;
        }
    }
    policy-statement private-filter {
        term private4 {
            from {
                family inet;
                prefix-list-filter private4 orlonger;
            }
            then next policy;
        }
        term private6 {
            from {
                family inet6;
                prefix-list-filter private6 orlonger;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement public-filter {
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term public6 {
            from {
                family inet6;
                prefix-list-filter public6 orlonger;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement reject {
        term reject {
            then reject;
        }
    }
    policy-statement transit-out-filter {
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term pa6 {
            from {
                family inet6;
                prefix-list-filter pa6 orlonger;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement wire-filter {
        term wire {
            from {
                protocol bgp;
                as-path wire;
            }
            then next policy;
        }
        term rk26arena {
            from {
                protocol bgp;
                as-path rk26arena;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    community AWS:LOCAL_PREF_HIGH members 7224:7300;
    community AWS:LOCAL_PREF_LOW members 7224:7100;
    community AWS:LOCAL_PREF_MEDIUM members 7224:7200;
    community RK:AWSNAT_OUTSIDE members 65000:44;
    as-path wire ".* (65080|65081|65082|65088|65089)+";
    as-path rk26arena ".* 65031+";
}
firewall {
    family inet {
        filter border-in4 {
            term link {
                from {
                    source-prefix-list {
                        link4;
                    }
                }
                then accept;
            }
            term discard-bogon {
                from {
                    source-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term accept-all {
                then accept;
            }
        }
        filter etherip-public-in4 {
            term link {
                from {
                    source-prefix-list {
                        link4;
                    }
                }
                then accept;
            }
            term discard-bogon-src {
                from {
                    source-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-bogon-dst {
                from {
                    destination-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-private-src {
                from {
                    source-prefix-list {
                        private4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-private-dst {
                from {
                    destination-prefix-list {
                        private4;
                    }
                }
                then {
                    discard;
                }
            }
            term accept-all {
                then accept;
            }
        }
        filter loopback-in4 {
            term icmp {
                from {
                    protocol icmp;
                }
                then accept;
            }
            term permit-dhcp {
                from {
                    destination-port [ dhcp 67 68 ];
                }
                then accept;
            }
            term return-tcp {
                from {
                    protocol tcp;
                    tcp-established;
                }
                then accept;
            }
            term management {
                from {
                    source-prefix-list {
                        mgmt4;
                    }
                    destination-port [ snmp ssh ];
                }
                then accept;
            }
            term udp-apps {
                from {
                    protocol udp;
                    source-port [ domain ntp ];
                }
                then accept;
            }
            term bgp {
                from {
                    source-prefix-list {
                        link4;
                    }
                    protocol tcp;
                    destination-port bgp;
                }
                then accept;
            }
            /* KB11436: https://supportportal.juniper.net/s/article/Junos-Why-does-the-Network-Time-Protocol-NTP-stop-working-if-a-loopback-firewall-filter-is-applied?language=en_US */
            term ntp-management {
                from {
                    source-address {
                        10.33.0.30/32;
                    }
                    destination-port ntp;
                }
                then accept;
            }
            term discard-all {
                then {
                    discard;
                }
            }
        }
        filter usr-in4 {
            term permit-icmp {
                from {
                    protocol icmp;
                }
                then accept;
            }
            term deny-op25b {
                from {
                    destination-port 25;
                }
                then {
                    discard;
                }
            }
            term deny-onpremises {
                from {
                    destination-prefix-list {
                        onpremises4;
                    }
                }
                then {
                    discard;
                }
            }
            term permit-all {
                then accept;
            }
        }
    }
    family inet6 {
        filter border-in6 {
            term link {
                from {
                    source-prefix-list {
                        link6;
                    }
                }
                then accept;
            }
            term discard-bogon {
                from {
                    source-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term accept-all {
                then accept;
            }
        }
        filter etherip-public-in6 {
            term link {
                from {
                    source-prefix-list {
                        link6;
                    }
                }
                then accept;
            }
            term discard-bogon-src {
                from {
                    source-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term discard-bogon-dst {
                from {
                    destination-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term accept-all {
                then accept;
            }
        }
        filter loopback-in6 {
            term icmp {
                from {
                    next-header icmpv6;
                }
                then accept;
            }
            term return-tcp {
                from {
                    next-header tcp;
                    tcp-established;
                }
                then accept;
            }
            term management {
                from {
                    source-prefix-list {
                        mgmt6;
                    }
                    destination-port [ snmp ssh ];
                }
                then accept;
            }
            term udp-apps {
                from {
                    next-header udp;
                    source-port [ domain ntp ];
                }
                then accept;
            }
            term bgp {
                from {
                    source-prefix-list {
                        link6;
                    }
                    next-header tcp;
                    destination-port bgp;
                }
                then accept;
            }
            term discard-all {
                then discard;
            }
            term ntp-management {
                from {
                    destination-port ntp;
                }
            }
        }
        filter usr-in6 {
            term permit-icmp {
                from {
                    next-header icmp6;
                }
                then accept;
            }
            term deny-op25b {
                from {
                    destination-port 25;
                }
                then discard;
            }
            term permit-nat64 {
                from {
                    destination-prefix-list {
                        pref64n;
                    }
                }
                then accept;
            }
            term iperf {
                from {
                    destination-port 5201;
                }
                then accept;
            }
            term deny-onpremises {
                from {
                    destination-prefix-list {
                        pa6;
                    }
                }
                then discard;
            }
            term permit-all {
                then accept;
            }
        }
    }
}
