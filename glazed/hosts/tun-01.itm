!
route-map aws-in permit 1
  match ip address prefix-list pl-private
  set local-preference 100
!
route-map aws-lo-in permit 1
  match ip address prefix-list pl-private
  set local-preference 90
!
route-map aws-lo-out permit 1
  match ip address prefix-list pl-private-aggregate
  set community 7224:7100 additive
!
route-map aws-lo-out permit 2
  match ip address prefix-list default
  set community 7224:7100 additive
!
route-map aws-out permit 1
  match ip address prefix-list pl-private-aggregate
  set community 7224:7200 additive
!
route-map aws-out permit 2
  match ip address prefix-list pl-default
  set community 7224:7200 additive
!
route-map bb-in permit 1
  match ip address prefix-list pl-private
  set local-preference 100
!
route-map bb-in permit 2
  match ip address prefix-list pl-public
  set local-preference 100
!
route-map bb-in permit 3
  match ip address prefix-list pl-default
  set local-preference 100
!
route-map bb-out permit 1
  match ip address prefix-list pl-private
!
route-map bb-out permit 2
  match ip address prefix-list pl-public
!
route-map bb-out permit 3
  match ip address prefix-list pl-default
!
route-map default-in permit 1
  match ip address prefix-list pl-default
!
route-map default-out permit 1
  match ip address prefix-list pl-default
!
route-map private-hi-in permit 1
  match ip address prefix-list pl-private
  set local-preference 120
!
route-map private-in permit 1
  match ip address prefix-list pl-private
  set local-preference 100
!
route-map private-lo-in permit 1
  match ip address prefix-list pl-private
  set local-preference 90
!
route-map private-out permit 1
  match ip address prefix-list pl-private
!
route-map public-in permit 1
  match ip address prefix-list pl-public
  set local-preference 100
!
route-map public-out permit 1
  match ip address prefix-list pl-public
!
router bgp 65153
  router-id 10.33.0.153
  default-local-preference 99
  default-metric 100
  neighbor 10.33.22.164 remote-as 65003
  neighbor 10.33.22.164 connect-interval 10
  neighbor 10.33.22.164 timers 6 30
  neighbor 10.33.22.164 description GigaEthernet2.1 br-01.itm
  neighbor 10.33.22.164 advertisement-interval 6
  address-family ipv4 unicast
    neighbor 10.33.22.164 route-map bb-in in
    neighbor 10.33.22.164 route-map bb-out out
    network 10.33.0.153/32
!
policy-map qos0
  class class-local
    set ipv6 dscp 0
    set ip dscp 0
  class class-default
    set ipv6 dscp 0
    set ip dscp 0
!
ikev2 default-profile
  child-lifetime 3600
  child-pfs 2048-bit
  child-proposal enc aes-cbc-256
  child-proposal integrity sha2-256
  dpd interval 10
  local-authentication id fqdn tun-01.itm.rubykaigi.net
  sa-lifetime 21600
  sa-proposal enc aes-cbc-256
  sa-proposal integrity sha2-512
  sa-proposal dh 2048-bit
  sa-proposal prf sha2-512
  ipsec-mode tunnel
!
device GigaEthernet0
!
device GigaEthernet1
!
device GigaEthernet2
  port 2 shutdown
  port 4 shutdown
  port 5 shutdown
  port 6 shutdown
  port 7 shutdown
  port 8 shutdown
  vlan-group 3 port 3
!
device BRI0
  isdn switch-type hsd128k
!
device USB0
  shutdown
!
interface GigaEthernet0.0
  description Circuit: ngnx
  no ip address
  ipv6 enable
  ipv6 interface-identifier 03:89:00:00:00:00:78:b1
  ipv6 address autoconfig
  ipv6 filter p-icmp 10 in
  ipv6 filter p-ipsec 100 in
  ipv6 filter p-etherip 101 in
  ipv6 filter p-ntp 110 in
  ipv6 filter p-dns 111 in
  ipv6 filter p-all 9000 out
  service-policy output qos0
  no shutdown
!
interface GigaEthernet1.0
  description Downstream: ge-0/0/0@br-01.itm
  no ip address
  shutdown
!
interface GigaEthernet2.0
