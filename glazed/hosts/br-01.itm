                route-filter 0.0.0.0/0 exact;
            }
            then next policy;
        }
        term default6 {
            from {
                family inet6;
                route-filter ::/0 exact;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement ecmp {
        then {
            load-balance per-packet;
        }
    }
    policy-statement enable-multipath {
        term multipath {
            then {
                load-balance consistent-hash;
            }
        }
    }
    policy-statement export-multipath {
        term multipath {
            then {
                load-balance per-flow;
            }
        }
    }
    /* see groups disconnecting-ngn */
    policy-statement groups-disconnecting-ngn-trigger {
        then next policy;
    }
    policy-statement keepaway-1x {
        term prepend {
            then {
                as-path-expand last-as count 1;
            }
        }
    }
    policy-statement local-pref-lo {
        apply-groups policy-skip-when-local-pref-is-zero;
        then {
            local-preference 90;
        }
    }
    policy-statement private-filter {
        term private4 {
            from {
                family inet;
                prefix-list-filter private4 orlonger;
            }
            then next policy;
        }
        term private6 {
            from {
                family inet6;
                prefix-list-filter private6 orlonger;
            }
            then next policy;
        }
        term awsnat-outside4 {
            from {
                family inet;
                community RK:AWSNAT_OUTSIDE;
            }
            then accept;
        }
        term reject {
            then reject;
        }
    }
    policy-statement public-filter {
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term public6 {
            from {
                family inet6;
                prefix-list-filter public6 orlonger;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement reject {
        term reject {
            then reject;
        }
    }
    policy-statement transit-out-filter {
        term resolver-lb {
            from {
                family inet;
                route-filter 192.50.220.164/31 orlonger;
            }
            then reject;
        }
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term pa6 {
            from {
                family inet6;
                prefix-list-filter pa6 exact;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement venue-filter {
        term no-venue {
            from community RK:NO_VENUE;
            then reject;
        }
        term next {
            then next policy;
        }
    }
    community AWS:LOCAL_PREF_HIGH members 7224:7300;
    community AWS:LOCAL_PREF_LOW members 7224:7100;
    community AWS:LOCAL_PREF_MEDIUM members 7224:7200;
    community RK:AWSNAT_OUTSIDE members 65000:44;
    community RK:NO_VENUE members 65000:6010;
    as-path awsvpc ".* 64512";
}
firewall {
    family inet {
        filter border-in4 {
            term link {
                from {
                    source-prefix-list {
                        link4;
                    }
                }
                then accept;
            }
            term discard-bogon {
                from {
                    source-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term accept-all {
                then accept;
            }
        }
        filter downstream-public-in4 {
            term link {
                from {
                    source-prefix-list {
                        link4;
                    }
                }
                then accept;
            }
            term discard-bogon-src {
                from {
                    source-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-bogon-dst {
                from {
                    destination-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-private-src {
                from {
                    source-prefix-list {
                        private4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-private-dst {
                from {
                    destination-prefix-list {
                        private4;
                    }
                }
                then {
                    discard;
                }
            }
            term accept-all {
                then accept;
            }
        }
        filter loopback-in4 {
            term icmp {
                from {
                    protocol icmp;
                }
                then accept;
            }
            term return-tcp {
                from {
                    protocol tcp;
                    tcp-established;
                }
                then accept;
            }
            term management {
                from {
                    source-prefix-list {
                        mgmt4;
                    }
                    destination-port [ snmp ssh ];
                }
                then accept;
            }
            term udp-apps {
                from {
                    protocol udp;
                    source-port [ domain ntp ];
                }
                then accept;
            }
            term bgp {
                from {
                    source-prefix-list {
                        link4;
                    }
                    protocol tcp;
                    destination-port bgp;
                }
                then accept;
            }
            /* KB11436: https://supportportal.juniper.net/s/article/Junos-Why-does-the-Network-Time-Protocol-NTP-stop-working-if-a-loopback-firewall-filter-is-applied?language=en_US */
            term ntp-management {
                from {
                    source-address {
                        10.33.0.3/32;
                    }
                    destination-port ntp;
                }
                then accept;
            }
            term discard-all {
                then {
                    discard;
                }
            }
            term bfd {
                from {
                    protocol udp;
                    destination-port 3784;
                }
            }
        }
    }
    family inet6 {
        filter border-in6 {
            term link {
                from {
                    source-prefix-list {
                        link6;
                    }
                }
                then accept;
            }
            term discard-bogon {
                from {
                    source-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term accept-all {
                then accept;
            }
        }
        filter downstream-public-in6 {
            term link {
                from {
                    source-prefix-list {
                        link6;
                    }
                }
                then accept;
            }
            term discard-bogon-src {
                from {
                    source-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term discard-bogon-dst {
                from {
                    destination-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term accept-all {
                then accept;
            }
        }
        filter loopback-in6 {
            term icmp {
                from {
                    next-header icmp6;
                }
                then accept;
            }
            term return-tcp {
                from {
                    next-header tcp;
                    tcp-established;
                }
                then accept;
            }
            term management {
                from {
                    source-prefix-list {
                        mgmt6;
                    }
                    destination-port [ snmp ssh ];
                }
                then accept;
            }
            term udp-apps {
                from {
                    next-header udp;
                    source-port [ domain ntp ];
                }
                then accept;
            }
            term bgp {
                from {
                    source-prefix-list {
                        link6;
                    }
                    next-header tcp;
                    destination-port bgp;
                }
                then accept;
            }
            term discard-all {
                then discard;
            }
            term ntp-management {
                from {
                    destination-port ntp;
                }
            }
            term bfd {
                from {
                    next-header udp;
                    destination-port 3784;
                }
            }
            term ipip6 {
                from {
                    next-header ipip;
                }
                then accept;
            }
            term ip6ip6 {
                from {
                    next-header ipv6;
                }
                then accept;
            }
        }
    }
}
protocols {
    bgp {
        group transit {
            import [ default-filter accept ];
            family inet {
                unicast;
            }
            family inet6 {
                unicast;
            }
            export [ transit-out-filter keepaway-1x accept ];
            neighbor 2001:0df0:8500:ca2c::a {
                description "Transit: AS59128 KMC, yume.box2";
                family inet {
                    unicast {
                        local-ipv4-address 192.50.220.157;
                    }
                }
                family inet6 {
                    unicast;
                }
                peer-as 59128;
                local-as 4264600033 loops 2;
            }
        }
        group bb {
            import [ bb-filter accept ];
            family inet {
                unicast;
            }
            family inet6 {
                unicast;
            }
            export [ bb-filter accept ];
            neighbor 2001:df0:8500:ca22:10::a {
                description "Core: ge-0/0/1.13@br-01.nrt";
                family inet {
                    unicast {
                        local-ipv4-address 10.33.22.11;
                    }
                }
                family inet6 {
                    unicast;
                }
                peer-as 65002;
            }
            neighbor 2001:df0:8500:ca22:12::a {
                description "Core: ge-0/0/1.13@br-01.hnd";
                family inet {
                    unicast {
                        local-ipv4-address 10.33.22.13;
                    }
                }
                family inet6 {
                    unicast;
                }
                peer-as 65001;
            }
        }
        group tun {
            import [ bb-filter local-pref-lo accept ];
            family inet {
                unicast;
            }
            export [ bb-filter aws-local-pref-low accept ];
            neighbor 10.33.22.165 {
                description "Core: GigaEthernet2.1@tun-01.itm";
                peer-as 65153;
            }
        }
        group venue-private {
            import [ private-filter enable-multipath groups-disconnecting-ngn-trigger accept ];
            family inet {
                unicast;
            }
            family inet6 {
                unicast;
            }
            export [ private-filter venue-filter accept ];
            neighbor 2001:df0:8500:ca22:30::b {
                description "Downstream: ge-0/0/5.30@er-01.venue [etherip-ipsec]";
                family inet {
                    unicast {
                        local-ipv4-address 10.33.22.30;
                    }
                }
                family inet6 {
                    unicast;
                }
                peer-as 65010;
            }
            neighbor 2001:df0:8500:ca22:34::b {
                description "Downstream: ge-0/0/5.30@er-02.venue [etherip-ipsec]";
                family inet {
                    unicast {
                        local-ipv4-address 10.33.22.34;
                    }
                }
                family inet6 {
                    unicast;
                }
                peer-as 65010;
            }
        }
        group venue-public {
            import [ public-filter enable-multipath groups-disconnecting-ngn-trigger accept ];
            family inet {
                unicast;
            }
            family inet6 {
                unicast;
            }
            export [ default-filter venue-filter accept ];
            /* this is required for ECMP from downstream / `private` is mandatory to avoid AS path loop on BRs for re-advertised routes from other BRs */
            local-as 65000 private no-prepend-global-as;
            shutdown;
            neighbor 2001:df0:8500:ca22:32::b {
                description "Downstream: ge-0/0/5.31@er-01.venue [etherip]";
                family inet {
                    unicast {
                        local-ipv4-address 10.33.22.32;
                    }
                }
                family inet6 {
                    unicast;
                }
                peer-as 65010;
            }
            neighbor 2001:df0:8500:ca22:36::b {
                description "Downstream: ge-0/0/5.31@er-02.venue [etherip]";
                family inet {
                    unicast {
                        local-ipv4-address 10.33.22.36;
                    }
                }
                family inet6 {
                    unicast;
                }
                peer-as 65010;
            }
        }
        metric-out 100;
        preference 100;
        hold-time 30;
        multipath;
    }
    lldp {
        port-id-subtype interface-name;
        neighbour-port-info-display port-id;
        interface all;
    }
}
routing-options {
    rib inet6.0 {
        static {
            route 2001:0df0:8500:ca00::/56 discard;
        }
    }
    router-id 10.33.0.3;
    autonomous-system 65003;
    static {
        route 10.33.0.0/16 discard;
        route 10.33.0.0/17 discard;
        route 192.50.220.152/29 discard;
        route 192.50.220.160/29 discard;
        route 192.50.220.168/29 discard;
    }
    forwarding-table {
        export export-multipath;
    }
}
