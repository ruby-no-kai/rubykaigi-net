    policy-statement bb-aggregate-filter {
        term default4 {
            from {
                route-filter 0.0.0.0/0 exact;
            }
            then next policy;
        }
        term default6 {
            from {
                route-filter ::/0 exact;
            }
            then next policy;
        }
        term private4 {
            from {
                family inet;
                prefix-list-filter private4 exact;
            }
            then next policy;
        }
        term private6 {
            from {
                family inet6;
                prefix-list-filter private6 exact;
            }
            then next policy;
        }
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term public6 {
            from {
                family inet6;
                prefix-list-filter public6 orlonger;
            }
            then next policy;
        }
