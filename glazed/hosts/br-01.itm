## Last commit: 2026-10-16 03:31:17 UTC by rk
version 24.2R1-S2.5;
groups {
    /* https://scrapbox.io/rknet/2024_%E6%97%A5%E6%AC%A1%E3%82%BF%E3%82%B9%E3%82%AF */
    disconnecting-ngn {
        policy-options {
            policy-statement groups-disconnecting-ngn-trigger {
                term trigger {
                    then {
                        local-preference 0;
                    }
                }
            }
        }
        protocols {
            bgp {
                group venue-private {
                    graceful-shutdown {
                        sender;
                    }
                }
                group venue-public {
                    graceful-shutdown {
                        sender;
                    }
                }
            }
        }
    }
    policy-skip-when-local-pref-is-zero {
        policy-options {
            policy-statement <*> {
                term skip-when-local-pref-is-zero {
                    from local-preference 0;
                    then next policy;
                }
            }
        }
    }
}
