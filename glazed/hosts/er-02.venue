    policy-statement accept {
        then accept;
    }
    policy-statement aws-local-pref-hi {
        then {
            community add AWS:LOCAL_PREF_HIGH;
        }
    }
    policy-statement aws-local-pref-low {
        then {
            community add AWS:LOCAL_PREF_LOW;
        }
    }
    policy-statement aws-local-pref-med {
        then {
            community add AWS:LOCAL_PREF_MEDIUM;
        }
    }
    policy-statement bb-filter {
        term default4 {
            from {
                route-filter 0.0.0.0/0 exact;
            }
            then next policy;
        }
        term default6 {
            from {
                route-filter ::/0 exact;
            }
            then next policy;
        }
        term private4 {
            from {
                family inet;
                prefix-list-filter private4 orlonger;
            }
            then next policy;
        }
        term private6 {
            from {
                family inet6;
                prefix-list-filter private6 orlonger;
            }
            then next policy;
        }
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term public6 {
            from {
                family inet6;
                prefix-list-filter public6 orlonger;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement default-filter {
        term default4 {
            from {
                family inet;
                route-filter 0.0.0.0/0 exact;
            }
            then next policy;
        }
        term default6 {
            from {
                family inet6;
                route-filter ::/0 exact;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement default4-reject {
        term default4 {
            from {
                family inet;
                route-filter 0.0.0.0/0 exact;
            }
            then reject;
        }
    }
    policy-statement ecmp {
        then {
            load-balance per-packet;
        }
    }
    policy-statement enable-multipath {
        term multipath {
            then {
                load-balance consistent-hash;
            }
        }
    }
    policy-statement export-multipath {
        term multipath {
            then {
                load-balance per-flow;
            }
        }
    }
    policy-statement local-pref-lo {
        apply-groups policy-skip-when-local-pref-is-zero;
        then {
            local-preference 90;
        }
    }
    policy-statement private-filter {
        term private4 {
            from {
                family inet;
                prefix-list-filter private4 orlonger;
            }
            then next policy;
        }
        term private6 {
            from {
                family inet6;
                prefix-list-filter private6 orlonger;
            }
            then next policy;
        }
        term awsnat-outside4 {
            from {
                family inet;
                community RK:AWSNAT_OUTSIDE;
            }
            then accept;
        }
        term reject {
            then reject;
        }
    }
    policy-statement public-filter {
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term public6 {
            from {
                family inet6;
                prefix-list-filter public6 orlonger;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    policy-statement reject {
        term reject {
            then reject;
        }
    }
    policy-statement rk-nocs-reject {
        term nocs-reject {
            from community RK:NO_CS;
            then reject;
        }
        term next {
            then next policy;
        }
    }
    policy-statement transit-out-filter {
        term public4 {
            from {
                family inet;
                prefix-list-filter public4 orlonger;
            }
            then next policy;
        }
        term pa6 {
            from {
                family inet6;
                prefix-list-filter pa6 orlonger;
            }
            then next policy;
        }
        term reject {
            then reject;
        }
    }
    community AWS:LOCAL_PREF_HIGH members 7224:7300;
    community AWS:LOCAL_PREF_LOW members 7224:7100;
    community AWS:LOCAL_PREF_MEDIUM members 7224:7200;
    community RK:AWSNAT_OUTSIDE members 65000:44;
    community RK:NO_CS members 65000:6030;
}
firewall {
    family inet {
        filter border-in4 {
            term link {
                from {
                    source-prefix-list {
                        link4;
                    }
                }
                then accept;
            }
            term discard-bogon {
                from {
                    source-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term accept-all {
                then accept;
            }
        }
        filter etherip-public-in4 {
            term link {
                from {
                    source-prefix-list {
                        link4;
                    }
                }
                then accept;
            }
            term discard-bogon-src {
                from {
                    source-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-bogon-dst {
                from {
                    destination-prefix-list {
                        bogon4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-private-src {
                from {
                    source-prefix-list {
                        private4;
                    }
                }
                then {
                    discard;
                }
            }
            term discard-private-dst {
                from {
                    destination-prefix-list {
                        private4;
                    }
                }
                then {
                    discard;
                }
            }
            term accept-all {
                then accept;
            }
        }
        filter loopback-in4 {
            term icmp {
                from {
                    protocol icmp;
                }
                then accept;
            }
            term return-tcp {
                from {
                    protocol tcp;
                    tcp-established;
                }
                then accept;
            }
            term management {
                from {
                    source-prefix-list {
                        mgmt4;
                    }
                    destination-port [ snmp ssh ];
                }
                then accept;
            }
            term udp-apps {
                from {
                    protocol udp;
                    source-port [ domain ntp ];
                }
                then accept;
            }
            term bgp {
                from {
                    source-prefix-list {
                        link4;
                    }
                    protocol tcp;
                    destination-port bgp;
                }
                then accept;
            }
            /* KB11436: https://supportportal.juniper.net/s/article/Junos-Why-does-the-Network-Time-Protocol-NTP-stop-working-if-a-loopback-firewall-filter-is-applied?language=en_US */
            term ntp-management {
                from {
                    source-address {
                        10.33.0.12/32;
                    }
                    destination-port ntp;
                }
                then accept;
            }
            term discard-all {
                then {
                    discard;
                }
            }
        }
    }
    family inet6 {
        filter border-in6 {
            term link {
                from {
                    source-prefix-list {
                        link6;
                    }
                }
                then accept;
            }
            term discard-bogon {
                from {
                    source-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term accept-all {
                then accept;
            }
        }
        filter etherip-public-in6 {
            term link {
                from {
                    source-prefix-list {
                        link6;
                    }
                }
                then accept;
            }
            term discard-bogon-src {
                from {
                    source-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term discard-bogon-dst {
                from {
                    destination-prefix-list {
                        bogon6;
                    }
                }
                then discard;
            }
            term accept-all {
                then accept;
            }
        }
        filter loopback-in6 {
            term icmp {
                from {
                    next-header icmp6;
                }
                then accept;
            }
            term return-tcp {
                from {
                    next-header tcp;
                    tcp-established;
                }
                then accept;
            }
            term management {
                from {
                    source-prefix-list {
                        mgmt6;
                    }
                    destination-port [ snmp ssh ];
                }
                then accept;
            }
            term udp-apps {
                from {
                    next-header udp;
                    source-port [ domain ntp ];
                }
                then accept;
            }
            term bgp {
                from {
                    source-prefix-list {
                        link6;
                    }
                    next-header tcp;
                    destination-port bgp;
                }
                then accept;
            }
            term discard-all {
                then discard;
            }
            term ntp-management {
                from {
                    destination-port ntp;
                }
            }
        }
    }
}
