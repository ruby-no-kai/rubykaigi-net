ip dhcp profile scout-a
  assignable-range 10.33.37.50 10.33.37.250
  dns-server 10.33.0.72
  domain-name scout-a.on.rubykaigi.net
  lease-time 1800
!
ip dhcp profile scout-b
  assignable-range 10.33.38.50 10.33.38.250
  dns-server 10.33.0.72
  domain-name scout-b.on.rubykaigi.net
  lease-time 1800
!
router bgp 65172
  router-id 10.33.0.72
  default-local-preference 99
  default-metric 100
  neighbor 10.33.22.76 remote-as 65002
  neighbor 10.33.22.76 connect-interval 10
  neighbor 10.33.22.76 timers 6 30
  neighbor 10.33.22.76 description GigaEthernet0.1 br-01.nrt
  neighbor 10.33.22.76 advertisement-interval 6
  neighbor 10.33.22.78 remote-as 65002
  neighbor 10.33.22.78 connect-interval 10
  neighbor 10.33.22.78 timers 6 30
  neighbor 10.33.22.78 description GigaEthernet0.2 br-01.nrt
  neighbor 10.33.22.78 advertisement-interval 6
  address-family ipv4 unicast
    neighbor 10.33.22.76 route-map private-in in
    neighbor 10.33.22.76 route-map private-out out
    neighbor 10.33.22.78 route-map default-in in
    neighbor 10.33.22.78 route-map public-out out
    network 10.33.0.72/32
    network 10.33.37.0/24
    network 10.33.38.0/24
    network 192.50.220.172/32
!
policy-map qos0
  class class-local
    set ipv6 dscp 0
    set ip dscp 0
  class class-default
    set ipv6 dscp 0
    set ip dscp 0
!
ikev2 default-profile
  child-lifetime 3600
  child-pfs 2048-bit
  child-proposal enc aes-cbc-256
  child-proposal integrity sha2-256
  dpd interval 10
  local-authentication id fqdn recon-01.nrt.rubykaigi.net
  sa-lifetime 21600
  sa-proposal enc aes-cbc-256
  sa-proposal integrity sha2-512
  sa-proposal dh 2048-bit
  sa-proposal prf sha2-512
  ipsec-mode tunnel
!
device GigaEthernet0
!
device GigaEthernet1
  port 3 shutdown
  port 4 shutdown
  vlan-group 1 port 1
  vlan-group 2 port 2
!
interface GigaEthernet0.0
  description Upstream: ge-0/0/2@br-01.nrt
  no ip address
  shutdown
!
interface GigaEthernet1.0
  no ip address
  shutdown
!
interface GigaEthernet0.1
  description Upstream: ge-0/0/2.1@br-01.nrt [v4private+v6all]
  encapsulation dot1q 1 tpid 8100
  auto-connect
  ip address 10.33.22.77/31
  ipv6 enable
  ipv6 address 2001:df0:8500:ca22:76::b/127
  ipv6 filter p-icmp 10 in
  ipv6 filter p-tcpest 8000 in
  ipv6 filter p-udpany 8010 in
  ipv6 filter p-all 9000 out
  no shutdown
!
interface GigaEthernet0.2
  description Upstream: ge-0/0/2.2@br-01.nrt [v4public]
  encapsulation dot1q 2 tpid 8100
  auto-connect
  ip address 10.33.22.79/31
  ip napt enable
  ip napt address 192.50.220.172
  ip napt inside list nat-inside
  ip napt translation max-entries per-address 350
  ip napt translation tcp-timeout 120
  ip napt translation udp-timeout 120
  ip napt translation icmp-timeout 10
  ip napt translation dns-timeout 10
  ip napt translation gre-timeout 600
  ip napt translation syn-timeout 300
  ip napt translation finrst-timeout 15
  ip napt translation other-timeout 600
  ip napt translation port-range 1025-65535
  ip napt service ping 10.33.0.72 none icmp any
  ip filter p-icmp 100 in
  ip filter p-link 101 in
  ip filter d-bogon-src 200 in
  ip filter p-tcpest 8000 in
  ip filter p-udpany 8010 in
  ip filter d-all 9000 in
  ip filter p-link 100 out
  ip filter d-op25b 1000 out
  ip filter d-bogon-dst 1100 out
  ip filter p-all 9000 out
  no shutdown
!
interface GigaEthernet1:1.0
  description Circuit: ngn6ix.sorah [ngn]
  no ip address
  ipv6 enable
  ipv6 interface-identifier 00:78:00:00:00:00:7c:02
  ipv6 address autoconfig
  ipv6 filter p-icmp 10 in
  ipv6 filter p-ipsec 100 in
  ipv6 filter p-etherip 101 in
  ipv6 filter p-ntp 110 in
  ipv6 filter p-dns 111 in
  ipv6 filter p-all 9000 out
  service-policy output qos0
  no shutdown
!
interface GigaEthernet1:2.0
  no ip address
  bridge-group 1
  no shutdown
!
interface BVI1
  description Access: {scout-a} Tun1.0
  ip address 10.33.37.254/24
  ip tcp adjust-mss 1300
  ip dhcp binding scout-a
  ipv6 enable
  ipv6 address 2001:df0:8500:ca37::a/64
  ipv6 address fe80::380a/64
  ipv6 tcp adjust-mss 1300
  ipv6 nd ra enable
  ipv6 nd ra dns-server 2001:df0:8500:ca00::72 1800
  ipv6 nd ra domain-name scout-a.on.rubykaigi.net 1800
  bridge-group 1
  no shutdown
!
interface BVI2
  description Access: {scout-b} Tun1.0
  ip address 10.33.38.254/24
  ip tcp adjust-mss 1330
  ip dhcp binding scout-b
  ipv6 enable
  ipv6 address 2001:df0:8500:ca38::a/64
  ipv6 tcp adjust-mss 1330
  ipv6 nd ra enable
  ipv6 nd ra dns-server 2001:df0:8500:ca00::72 1800
  ipv6 nd ra domain-name scout-a.on.rubykaigi.net 1800
  bridge-group 2
  no shutdown
!
interface Loopback0.0
  ip address 10.33.0.72/32
  ipv6 address 2001:df0:8500:ca00::72/128
!
interface Null0.0
  no ip address
!
interface Tunnel1.0
  description Downstream: Tun7.0@tun-01.venue, Gi1:1.0 {scout-a} [etherip-ipsec]
  tunnel mode ether-ip ipsec-ikev2
  no ip address
  bridge-group 1
  ikev2 connect-type auto
  ikev2 ipsec pre-fragment
  ikev2 outgoing-interface GigaEthernet1:1.0 fe80::a
  ikev2 source-address GigaEthernet1:1.0
  ikev2 ipsec-mode transport
  ikev2 peer any authentication psk id fqdn scout.tun-01.venue.rubykaigi.net
  no shutdown
!
interface Tunnel2.0
  description Downstream: Tun7.0@tun-02.venue, Gi1:1.0 {scout-b} [etherip-ipsec]
  tunnel mode ether-ip ipsec-ikev2
  no ip address
  bridge-group 2
  ikev2 connect-type auto
  ikev2 ipsec pre-fragment
  ikev2 outgoing-interface GigaEthernet1:1.0 fe80::a
  ikev2 source-address GigaEthernet1:1.0
  ikev2 ipsec-mode transport
  ikev2 peer any authentication psk id fqdn scout.tun-02.venue.rubykaigi.net
  no shutdown
