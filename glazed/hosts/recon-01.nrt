  match ip address prefix-list pl-private
  set local-preference 120
!
route-map private-in permit 1
  match ip address prefix-list pl-private
  set local-preference 100
!
route-map private-lo-in permit 1
  match ip address prefix-list pl-private
  set local-preference 90
!
route-map private-out permit 1
  match ip address prefix-list pl-private
!
route-map public-in permit 1
  match ip address prefix-list pl-public
  set local-preference 100
!
