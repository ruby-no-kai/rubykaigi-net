route-map aws-in permit 1
  match ip address prefix-list pl-private
  set local-preference 100
!
route-map aws-lo-in permit 1
  match ip address prefix-list pl-private
  set local-preference 90
!
route-map aws-lo-out permit 1
  match ip address prefix-list pl-private
  set community 7224:7100 additive
!
route-map aws-lo-out permit 2
  match ip address prefix-list default
  set community 7224:7100 additive
!
route-map aws-out permit 1
  match ip address prefix-list pl-private
  set community 7224:7200 additive
!
route-map aws-out permit 2
  match ip address prefix-list pl-default
  set community 7224:7200 additive
!
route-map bb-in permit 1
  match ip address prefix-list pl-private
  set local-preference 100
!
route-map bb-in permit 2
  match ip address prefix-list pl-public
  set local-preference 100
!
route-map bb-in permit 3
  match ip address prefix-list default
  set local-preference 100
!
route-map bb-out permit 1
  match ip address prefix-list pl-private
!
route-map bb-out permit 2
  match ip address prefix-list pl-public
!
route-map bb-out permit 3
  match ip address prefix-list default
!
route-map private-hi-in permit 1
  match ip address prefix-list pl-private
  set local-preference 120
!
route-map private-in permit 1
  match ip address prefix-list pl-private
  set local-preference 100
!
route-map private-lo-in permit 1
  match ip address prefix-list pl-private
  set local-preference 90
!
route-map private-out permit 1
  match ip address prefix-list pl-private
!
route-map public-in permit 1
  match ip address prefix-list pl-public
  set local-preference 100
!
route-map public-in permit 2
  match ip address prefix-list default
  set local-preference 100
!
route-map public-lo-in permit 1
  match ip address prefix-list pl-public
  set local-preference 90
!
route-map public-lo-in permit 2
  match ip address prefix-list default
  set local-preference 90
!
route-map public-out permit 1
  match ip address prefix-list pl-public
!
route-map public-out permit 2
  match ip address prefix-list default
