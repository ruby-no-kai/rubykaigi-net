router bgp 65024
  router-id 10.33.0.21
  default-local-preference 99
  default-metric 100
  neighbor 10.33.22.52 remote-as 65010
  neighbor 10.33.22.52 connect-interval 10
  neighbor 10.33.22.52 timers 6 30
  neighbor 10.33.22.52 description ge-0/0/1.1@er-01.venue
  neighbor 10.33.22.52 advertisement-interval 6
  neighbor 10.33.22.54 remote-as 65010
  neighbor 10.33.22.54 connect-interval 10
  neighbor 10.33.22.54 timers 6 30
  neighbor 10.33.22.54 description ge-0/0/1.2@er-01.venue
  neighbor 10.33.22.54 advertisement-interval 6
  neighbor 10.33.22.61 remote-as 65030
  neighbor 10.33.22.61 connect-interval 10
  neighbor 10.33.22.61 timers 6 30
  neighbor 10.33.22.61 description ge-0/0/22@cs-01.venue
  neighbor 10.33.22.61 advertisement-interval 6
  address-family ipv4 unicast
    originate-default
    no neighbor 10.33.22.52 send-default
    neighbor 10.33.22.52 route-map private-in in
    neighbor 10.33.22.52 route-map private-out out
    no neighbor 10.33.22.54 send-default
    neighbor 10.33.22.54 route-map public-in in
    neighbor 10.33.22.54 route-map public-out out
    neighbor 10.33.22.61 route-map bb-in in
    neighbor 10.33.22.61 route-map public-out out
    network 10.33.0.21/32
    network 192.50.220.160/32
!
policy-map qos0
  class class-local
    set ipv6 dscp 0
    set ip dscp 0
  class class-default
    set ipv6 dscp 0
    set ip dscp 0
!
device GigaEthernet0
!
device GigaEthernet1
  port 2 shutdown
  port 3 shutdown
  port 4 shutdown
!
interface GigaEthernet0.0
  description Upstream: ge-0/0/1@er-01.venue
  no ip address
  shutdown
!
interface GigaEthernet1.0
  description Downstream: ge-0/0/22@cs-01.venue
  ip address 10.33.22.60/31
  no shutdown
!
interface GigaEthernet0.1
  description Upstream: ge-0/0/1.1@er-01.venue {private}
  encapsulation dot1q 1 tpid 8100
  auto-connect
  ip address 10.33.22.53/31
  no shutdown
!
interface GigaEthernet0.2
  description Upstream: ge-0/0/1.1@er-01.venue {public}
  encapsulation dot1q 2 tpid 8100
  auto-connect
  ip address 10.33.22.55/31
  ip napt enable
  ip napt address 192.50.220.160
  ip napt inside list napt-inside-1
  ip napt translation max-entries 129020
  ip napt translation max-entries per-address 350
  ip napt translation tcp-timeout 120
  ip napt translation udp-timeout 120
  ip napt translation icmp-timeout 10
  ip napt translation dns-timeout 10
  ip napt translation gre-timeout 600
  ip napt translation syn-timeout 300
  ip napt translation finrst-timeout 15
  ip napt translation other-timeout 600
  ip napt translation port-range 1025-65535
  ip napt service ping 10.33.0.21 none icmp any
  ip filter p-icmp 100 in
  ip filter p-link 101 in
  ip filter p-ospf 102 in
  ip filter p-tcpest 8000 in
  ip filter p-udpany 8010 in
  ip filter d-all 9000 in
  ip filter d-op25b 1000 out
  ip filter p-all 9000 out
  no shutdown
!
interface Loopback0.0
  ip address 10.33.0.21/32
!
interface Null0.0
  no ip address
!
