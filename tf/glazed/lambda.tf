resource "aws_lambda_function" "glazed" {
  function_name = "glazed"

  package_type  = "Image"
  image_uri     = "${aws_ecr_repository.glazed-lambda.repository_url}:${local.image_tag}"
  architectures = ["x86_64"]
  publish       = true

  role = aws_iam_role.LambdaGlazed.arn

  memory_size = 1024
  timeout     = 300

  vpc_config {
    subnet_ids                  = data.aws_subnets.private.ids
    security_group_ids          = [aws_security_group.glazed.id]
    ipv6_allowed_for_dual_stack = true
  }

  environment {
    variables = {
      # S3 and SSM over IPv6 through the egress-only gateway, which stays up while NAT is off
      AWS_USE_DUALSTACK_ENDPOINT = "true"

      GLAZED_CONFIG_S3_BUCKET = aws_s3_object.config.bucket
      GLAZED_CONFIG_S3_KEY    = aws_s3_object.config.key
      GLAZED_CONFIG_S3_DIGEST = filebase64sha256(local.config_path)
    }
  }

  depends_on = [
    aws_ecr_repository_policy.glazed-lambda,
    aws_iam_role_policy.LambdaGlazed,
    aws_iam_role_policy_attachment.LambdaGlazed-AWSLambdaVPCAccessExecutionRole,
  ]
}

# The definition generated by the published version, from the config it runs with
resource "aws_lambda_invocation" "glazed-state-machine" {
  function_name = aws_lambda_function.glazed.function_name
  qualifier     = aws_lambda_function.glazed.version
  input         = jsonencode({ state_machine = {} })
}

# Runs the github step outside the VPC, to reach GitHub while NAT is off
resource "aws_lambda_function" "glazed-github" {
  function_name = "glazed-github"

  package_type  = "Image"
  image_uri     = "${aws_ecr_repository.glazed-lambda.repository_url}:${local.image_tag}"
  architectures = ["x86_64"]
  publish       = true

  role = aws_iam_role.LambdaGlazedGithub.arn

  memory_size = 1024
  timeout     = 300

  environment {
    variables = {
      GLAZED_CONFIG_S3_BUCKET = aws_s3_object.config.bucket
      GLAZED_CONFIG_S3_KEY    = aws_s3_object.config.key
      GLAZED_CONFIG_S3_DIGEST = filebase64sha256(local.config_path)
    }
  }

  depends_on = [
    aws_ecr_repository_policy.glazed-lambda,
    aws_iam_role_policy.LambdaGlazedGithub,
    aws_iam_role_policy_attachment.LambdaGlazedGithub-AWSLambdaBasicExecutionRole,
  ]
}
