  "orchestrator": {
    "state": {
      "sqlite": {
        "key": "state.sqlite3",
        "storage": "state"
      }
    },
    "workflows": {
      "backup": {
        "debounce": {
          "delay": "60s",
          "max_wait": "600s"
        },
        "lease": "1800s",
        "schedule": {
          "interval": "900s",
          "retry_interval": "60s"
        },
        "schedule_rules": []
      }
    }
  },
  "storages": {
    "github": {
      "github": {
        "branch": "config-staging",
        "repository": "ruby-no-kai/rubykaigi-net",
        "subdirectory": "glazed/hosts",
        "token": {
          "command": {
            "exec": [
              "ruby",
              "-e",
              "#!/usr/bin/env ruby\n# Prints a GitHub App installation token for ruby-no-kai/rubykaigi-net, from tf/sts-cat with the AWS web identity token of the caller.\n# glazed.jsonnet embeds it as the token command of the github storage. .github/sts-cat/glazed.sts.toml trusts the role of the glazed-github function.\nrequire 'bundler/setup'\nrequire 'aws-sdk-sts'\nrequire 'httpx'\nrequire 'json'\n\nAUDIENCE = 'https://sts-cat.rubykaigi.net'\nENDPOINT = 'https://yrlrly5nve2l23wqbwumadvi4i0wchbp.lambda-url.ap-northeast-1.on.aws/token'\n\njwt = Aws::STS::Client.new.get_web_identity_token(audience: [AUDIENCE], signing_algorithm: 'RS256').web_identity_token\nresponse = HTTPX.post(\n  ENDPOINT,\n  headers: { 'authorization' => \"Bearer #{jwt}\" },\n  json: { scope: 'ruby-no-kai/rubykaigi-net', identity: 'glazed' },\n)\nresponse.raise_for_status\nputs JSON.parse(response.body.to_s).fetch('token')\n"
            ]
          }
        }
      }
    },
    "raw": {
      "s3": {
        "bucket": "rk-infra",
        "prefix": "glazed/raw/"
      }
    },
    "redacted": {
      "s3": {
        "bucket": "rk-infra",
        "prefix": "glazed/redacted/"
      }
    },
    "state": {
      "s3": {
        "bucket": "rk-infra",
        "prefix": "glazed/state/"
      }
    }
  },
  "workflows": {
    "backup": {
      "steps": [
        {
          "fetch": {
            "output": "raw",
            "storage": "raw"
          },
          "name": "fetch"
        },
        {
          "name": "redact",
          "redact": {
            "input": "raw",
            "output": "redacted",
            "redaction": {
              "hmac_key": {
                "ssm": {
                  "name": "/glazed/prd/hmac-key"
                }
              },
              "mode": "MODE_HMAC",
              "secrets": [
                {
                  "note": "nrt-ngnx",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/nrt-ngnx"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "nrt-ngnn",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/nrt-ngnn"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "hnd-ngnx",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/hnd-ngnx"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "hnd-ngnn",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/hnd-ngnn"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "itm-ngn",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/itm-ngn"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "hnd-uplink",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/hnd-uplink"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "caf-no",
                  "ref": {
                    "value": "CAF\\d{10}"
                  },
                  "regexp": true
                }
              ]
            },
            "storage": "redacted"
          }
        },
        {
          "name": "github",
          "publish": {
            "input": "redacted",
            "storage": "github"
          }
        }
      ]
    }
  }
}
