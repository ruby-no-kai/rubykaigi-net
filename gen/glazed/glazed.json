  "orchestrator": {
    "state": {
      "sqlite": {
        "key": "state.sqlite3",
        "storage": "state"
      }
    },
    "workflows": {
      "backup": {
        "debounce": {
          "delay_seconds": 60,
          "max_wait_seconds": 600
        },
        "lease_seconds": 1800,
        "schedule": {
          "interval_seconds": 900,
          "retry_interval_seconds": 60
        }
      }
    }
  },
  "storages": {
    "raw": {
      "s3": {
        "bucket": "rk-infra",
        "prefix": "glazed/raw/"
      }
    },
    "redacted": {
      "s3": {
        "bucket": "rk-infra",
        "prefix": "glazed/redacted/"
      }
    },
    "state": {
      "s3": {
        "bucket": "rk-infra",
        "prefix": "glazed/state/"
      }
    }
  },
  "workflows": {
    "backup": {
      "steps": [
        {
          "fetch": {
            "output": "raw",
            "storage": "raw"
          },
          "name": "fetch"
        },
        {
          "name": "redact",
          "redact": {
            "input": "raw",
            "output": "redacted",
            "redaction": {
              "hmac_key": {
                "ssm": {
                  "name": "/glazed/prd/hmac-key"
                }
              },
              "mode": "MODE_HMAC",
              "secrets": [
                {
                  "note": "nrt-ngnx",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/nrt-ngnx"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "nrt-ngnn",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/nrt-ngnn"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "hnd-ngnx",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/hnd-ngnx"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "hnd-ngnn",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/hnd-ngnn"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "itm-ngn",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/itm-ngn"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "hnd-uplink",
                  "ref": {
                    "ssm": {
                      "name": "/glazed/prd/redact-pattern/hnd-uplink"
                    }
                  },
                  "regexp": true
                },
                {
                  "note": "caf-no",
                  "ref": {
                    "value": "CAF\\d{10}"
                  },
                  "regexp": true
                }
              ]
            },
            "storage": "redacted"
          }
        }
      ]
    }
  }
}
